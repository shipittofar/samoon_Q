// ============================================================
// Phase Z.1 — Backend Database Schema Freeze (DBML)
//
// Source of truth: docs/BACKEND_CONTRACT.md, docs/FRONTEND_CONTEXT_MODEL.md,
// docs/BACKEND_IMPLEMENTATION_PLAN.md
//
// Schema only. No Django code, no migrations, no models.py, no
// implementation detail beyond what a schema itself expresses.
// ============================================================

// ── Enums ─────────────────────────────────────────────────────────────────

// Deviation note (see "Schema Validation Notes" at the end of this file):
// the frozen contract (docs/BACKEND_CONTRACT.md §1, User.accountType)
// uses 'customer', not 'personal'. This schema follows the frozen
// contract's actual value rather than the task's abbreviated example —
// flagged explicitly, not silently resolved.
Enum account_type {
  customer
  business
}

// Deviation note: docs/BACKEND_IMPLEMENTATION_PLAN.md §1 (Tenant model)
// specifies 5 statuses, matching src/types/index.ts's Tenant.status and
// src/services/tenant.service.ts's ELIGIBLE_TENANT_STATUSES check. The
// task's example list ('active', 'suspended') is a subset; the full set
// is reproduced here as the actual frozen contract requires.
Enum tenant_status {
  active
  trial
  suspended
  churned
  archived
}

// Deviation note: docs/BACKEND_IMPLEMENTATION_PLAN.md §1 (Branch model)
// specifies 3 statuses (src/types/branch.ts's BranchStatus). The task's
// example list ('active', 'inactive') is a subset; 'maintenance' is
// retained as the frozen contract requires.
Enum branch_status {
  active
  inactive
  maintenance
}

Enum branch_scope {
  all
  selected
}

Enum membership_status {
  active
  suspended
  revoked
}

// ── Authentication Domain ───────────────────────────────────────────────

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar [unique, null, note: 'Nullable — phone-only accounts have no email (docs/BACKEND_CONTRACT.md §1)']
  phone_number varchar [unique, null]
  account_type account_type [not null, note: 'UX-only landing hint. NEVER an authorization signal — no global role field exists on this table by design (FRONTEND_CONTEXT_MODEL.md §1). Authorization comes exclusively from tenant_memberships.']
  first_name varchar [not null]
  last_name varchar [not null]
  avatar varchar [null]
  is_verified boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    email [unique, name: 'uq_users_email']
    phone_number [unique, name: 'uq_users_phone_number']
  }

  Note: 'One row per platform account. No tenant, role, or branch information ever lives here — see tenant_memberships. account_type answers "what experience before tenant context exists," nothing else.'
}

// ── Tenant Domain ────────────────────────────────────────────────────────

Table tenants {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null]
  slug varchar [not null, unique]
  status tenant_status [not null, default: 'trial']
  business_types jsonb [not null, default: `'[]'`, note: 'Flat list of strings — src/types/index.ts Tenant.businessTypes']
  settings jsonb [not null, default: `'{}'`, note: 'theme, contactEmail, businessHours, etc. — loose bag matching Tenant.settings on the frontend']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    slug [unique, name: 'uq_tenants_slug']
  }

  Note: 'The isolation boundary. No owner FK on this table — ownership is expressed exclusively via a tenant_memberships row with role=owner (docs/BACKEND_IMPLEMENTATION_PLAN.md §1), never a direct column here. slug is the primary lookup key, resolved from the request subdomain (docs/BACKEND_CONTRACT.md §6).'
}

// ── Branch Domain ────────────────────────────────────────────────────────

Table branches {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  name varchar [not null]
  slug varchar [not null]
  status branch_status [not null, default: 'active']
  is_default boolean [not null, default: false]
  location jsonb [not null, default: `'{}'`, note: 'address/city/country/lat/lng']
  contact jsonb [not null, default: `'{}'`, note: 'phone_number/email/website']
  business_hours jsonb [not null, default: `'[]'`]
  settings jsonb [not null, default: `'{}'`, note: 'delivery/pickup/tableOrdering/etc.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, slug) [unique, name: 'uq_branches_tenant_slug']
    (tenant_id, status) [name: 'ix_branches_tenant_status']
  }

  Note: 'Belongs to exactly one tenant (tenant_id FK, not null). Slug uniqueness is scoped per tenant, not global — two different tenants may each have a "main" branch.'
}

Ref: branches.tenant_id > tenants.id [delete: cascade]

// ── Membership Domain ────────────────────────────────────────────────────
//
// User -> TenantMembership -> Tenant. No BranchMembership table — branch
// access is a property of the membership as a whole (branch_scope),
// expanded via a join table only when scope = 'selected'. This is the
// architecture decision documented in docs/BACKEND_IMPLEMENTATION_PLAN.md
// §3: an 'all' scope must mean every CURRENT AND FUTURE branch, which a
// per-branch snapshot table cannot express — a scope flag can.

Table tenant_memberships {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  tenant_id uuid [not null]
  branch_scope branch_scope [not null, default: 'selected']
  status membership_status [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, tenant_id) [unique, name: 'uq_tenant_memberships_user_tenant']
    (user_id, status) [name: 'ix_tenant_memberships_user_status', note: 'primary query path for GET /auth/me']
    (tenant_id, status) [name: 'ix_tenant_memberships_tenant_status']
  }

  Note: 'One row per (user, tenant) — never more than one. Multiple roles for that user in that tenant live in tenant_membership_roles, not as multiple rows here. branch_scope=all means every current AND future branch of tenant_id; branch_scope=selected means exactly the branches listed in tenant_membership_branches.'
}

Ref: tenant_memberships.user_id > users.id [delete: cascade]
Ref: tenant_memberships.tenant_id > tenants.id [delete: cascade]

// assigned_branches — only meaningful/populated when branch_scope = 'selected'.
Table tenant_membership_branches {
  tenant_membership_id uuid [not null]
  branch_id uuid [not null]

  indexes {
    (tenant_membership_id, branch_id) [pk]
  }

  Note: 'Explicit branch grants for a branch_scope=selected membership. Ignored/expected-empty when the parent membership is branch_scope=all — application logic must not require rows here for an all-scope membership to resolve correctly.'
}

Ref: tenant_membership_branches.tenant_membership_id > tenant_memberships.id [delete: cascade]
Ref: tenant_membership_branches.branch_id > branches.id [delete: cascade]

// ── RBAC Domain ──────────────────────────────────────────────────────────

Table roles {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null]
  slug varchar [not null, unique, note: "owner | admin | manager | cashier | waiter | kitchen | marketing | support — fixed, seeded set. No custom roles this phase (docs/BACKEND_IMPLEMENTATION_PLAN.md §4)."]

  indexes {
    slug [unique, name: 'uq_roles_slug']
  }

  Note: 'Modeled as a real seeded table (not a CharField choice) so a future custom-roles phase does not require a schema change, while no custom-role capability is exposed via any API this phase.'
}

Table permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar [not null, unique, note: "dot-notation, e.g. 'orders.view' — matches resource + '.' + action"]
  resource varchar [not null, note: "e.g. 'orders', 'menu' — the noun before the dot in code"]
  action varchar [not null, note: "e.g. 'view', 'edit' — the verb after the dot in code"]

  indexes {
    code [unique, name: 'uq_permissions_code']
  }

  Note: 'Seeded to mirror ALL_PERMISSIONS (src/services/permission.service.ts) exactly — resource/action are derived/denormalized from code for query convenience, code remains the single source of truth string the frontend already checks against.'
}

Table role_permissions {
  role_id uuid [not null]
  permission_id uuid [not null]

  indexes {
    (role_id, permission_id) [pk]
  }

  Note: 'Plain many-to-many. Owner access is represented by seeding EVERY permission row against the owner role here — there is no runtime "if role == owner" bypass anywhere in the schema or the query path that reads it (docs/BACKEND_IMPLEMENTATION_PLAN.md §4). Seed data must reproduce ROLE_PERMISSION_MAP row-for-row.'
}

Ref: role_permissions.role_id > roles.id [delete: cascade]
Ref: role_permissions.permission_id > permissions.id [delete: cascade]

// tenant_membership_roles — because roles belong to the MEMBERSHIP
// (tenant-scoped), not to the user globally and not to the role in
// isolation. A membership may hold multiple roles; permissions union.
Table tenant_membership_roles {
  tenant_membership_id uuid [not null]
  role_id uuid [not null]

  indexes {
    (tenant_membership_id, role_id) [pk]
  }

  Note: 'A tenant_membership may hold more than one role (e.g. cashier + waiter) — permissions resolve as the UNION of every held role\'s permission_permissions, computed at read time, never denormalized onto this table.'
}

Ref: tenant_membership_roles.tenant_membership_id > tenant_memberships.id [delete: cascade]
Ref: tenant_membership_roles.role_id > roles.id [delete: cascade]

// ============================================================
// Relationship Diagram (textual — DBML above already encodes this via
// the Ref: statements; reproduced here for readability per Phase Z.1 §8)
//
//                         users
//                           |
//                           | 1:N (unique per tenant)
//                           |
//                   tenant_memberships ──M:N── roles ──M:N── permissions
//                     |            |
//                     | FK         | M:N (only when branch_scope=selected)
//                     |            |
//                  tenants      branches
//                                  ^
//                                  | FK (branches.tenant_id)
//                                  |
//                               tenants
// ============================================================
