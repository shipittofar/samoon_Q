# Server configuration — copied to /opt/samoon/.env by deploy/install.sh.
# This file is read by docker compose for ${VAR} substitution. Keep the real
# /opt/samoon/.env OUT of git (it is already in .gitignore).
#
# Fill in every placeholder value below before the first install.

# Address the site is served on: a domain, or the server's public IP when there
# is no domain yet. install.sh fills this from SERVER_IP / DOMAIN.
DOMAIN=CHANGE_ME

# Browser-reachable URLs (baked into the client bundle at build time).
NEXT_PUBLIC_APP_URL=https://CHANGE_ME
NEXT_PUBLIC_API_BASE_URL=https://CHANGE_ME/api
NEXT_PUBLIC_WS_BASE_URL=wss://CHANGE_ME/ws
NEXT_PUBLIC_ROOT_DOMAIN=CHANGE_ME
NEXT_PUBLIC_MEDIA_BASE_URL=

# Real backend (Django) — the app must not run on mock data in production.
NEXT_PUBLIC_USE_MOCK=false

# Optional integrations — leave empty if unused.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Backend container used by `samoon admin-add` (the backend stack's Django app).
BACKEND_CONTAINER=smartrestaurant-web

# Where the Next.js server reaches Django for server-side calls (internal
# docker network, no TLS). Browsers keep using NEXT_PUBLIC_API_BASE_URL.
INTERNAL_API_BASE_URL=http://smartrestaurant-web:8000/api
