# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Samoon
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Platform root domain for tenant subdomains (tenant-a.<root>). Optional;
# when set, only direct subdomains of it resolve to a tenant.
# NEXT_PUBLIC_ROOT_DOMAIN=samoon.app

# ─── Backend / Django ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/ws

# Public media/CDN origin for backend storage keys (e.g. menu_items/abc.webp).
# Falls back to platform config `storage.cdn_base_url` when unset.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://hot.ir-central1.arvanstorage.ir/your-bucket

# ─── Mock Mode ───────────────────────────────────────────────────────────────
# Set to "true" to use mock data without a real Django backend.
# Default is "false" (requires a running Django backend at NEXT_PUBLIC_API_BASE_URL).
# For local development without a backend, change this to "true".
NEXT_PUBLIC_USE_MOCK=false

# ─── Firebase (Push Notifications — optional) ─────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ─── Stripe (Payment Gateway — P4.1) ─────────────────────────────────────────
# Required for card payments when USE_MOCK=false. Get from stripe.com/docs/keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Analytics (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Sentry (optional) ────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
